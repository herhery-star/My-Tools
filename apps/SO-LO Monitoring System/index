        const { data: soData, error: soErr } = await sb
            .from('so')
            .insert([{ nomor_so, tanggal_so, spbu }])
            .select()
            .single();

        if (soErr) {
            alert('Gagal Simpan SO: ' + soErr.message);
            return;
        }

        const productsToInsert = selectedProducts.map(product => ({
            ...product,
            so_id: soData.id
        }));

        const { error: prodErr } = await sb
            .from('so_products')
            .insert(productsToInsert);

        if (prodErr) {
            // Best-effort rollback so an incomplete SO is not left behind.
            await sb.from('so').update({ deleted_at: new Date().toISOString() }).eq('id', soData.id);
            alert('Gagal Simpan Produk SO: ' + prodErr.message);
            return;
        }

        alert('SO berhasil disimpan.');
        document.getElementById('formSO').reset();
        setDefaultDates();
        await fetchDashboard();
