<!-- ADD-ON NAVIGATION HIDDEN -->
<div class="floating-nav-addon" aria-hidden="true" style="display:none"></div>
<script id="navigation-collapse-addon-script">
(function () {
    'use strict';

    function initNavigationCollapseAddon() {
        const topButton = document.getElementById('floatingTopAddon');
        const bottomButton = document.getElementById('floatingBottomAddon');
        const toggleButton = document.getElementById('completedToggleAddon');
        const completedContainer = document.getElementById('dashboardCompleted');

        if (topButton) {
            topButton.addEventListener('click', function () {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        }

        if (bottomButton) {
            bottomButton.addEventListener('click', function () {
                window.scrollTo({
                    top: document.documentElement.scrollHeight,
                    behavior: 'smooth'
                });
            });
        }

        if (toggleButton && completedContainer) {
            toggleButton.addEventListener('click', function () {
                const isCollapsed = completedContainer.classList.toggle(
                    'completed-collapsed-addon'
                );

                toggleButton.textContent = isCollapsed ? '+' : '−';
                toggleButton.setAttribute(
                    'aria-expanded',
                    isCollapsed ? 'false' : 'true'
                );
                toggleButton.title = isCollapsed
                    ? 'Tampilkan rincian SO Selesai'
                    : 'Sembunyikan rincian SO Selesai';
            });
        }
    }

    // Script berada setelah HTML utama, tetapi tetap aman jika urutan berubah.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initNavigationCollapseAddon, { once: true });
    } else {
        initNavigationCollapseAddon();
    }
})();
</script>

