    (function initDashboardSPBUFilter() {
        const blueBtn = document.getElementById('filterSPBU07');
        const greenBtn = document.getElementById('filterSPBU16');
        const activeContainer = document.getElementById('dashboardActive');
        const completedContainer = document.getElementById('dashboardCompleted');

        if (!blueBtn || !greenBtn || !activeContainer || !completedContainer) return;

        let activeFilter = '';

        function setButtonState() {
            const blueOn = !activeFilter || activeFilter === 'SPBU-74.906.07';
            const greenOn = !activeFilter || activeFilter === 'SPBU-74.906.16';

            blueBtn.classList.toggle('is-active', blueOn);
            greenBtn.classList.toggle('is-active', greenOn);
            blueBtn.setAttribute('aria-pressed', String(blueOn));
            greenBtn.setAttribute('aria-pressed', String(greenOn));
        }

        function updateEmptyMessage(container, hasCards, visibleCount) {
            let empty = container.querySelector('.dashboard-filter-empty');
            if (!activeFilter || !hasCards || visibleCount > 0) {
                if (empty) empty.remove();
                return;
            }
            if (!empty) {
                empty = document.createElement('div');
                empty.className = 'dashboard-filter-empty';
                container.appendChild(empty);
            }
            empty.textContent = `Tidak ada catatan untuk ${activeFilter}.`;
        }

        function applyFilter(filter) {
            activeFilter = activeFilter === filter ? '' : filter;

            [activeContainer, completedContainer].forEach(container => {
                const cards = Array.from(container.querySelectorAll('.so-table-card'));
                let visibleCount = 0;

                cards.forEach(card => {
                    const match = !activeFilter || card.dataset.dashboardSpbu === activeFilter;
                    card.classList.toggle('dashboard-spbu-hidden', !match);
                    if (match) visibleCount++;
                });

                updateEmptyMessage(container, cards.length > 0, visibleCount);
            });

            setButtonState();
        }

        blueBtn.addEventListener('click', () => applyFilter('SPBU-74.906.07'));
        greenBtn.addEventListener('click', () => applyFilter('SPBU-74.906.16'));

        // Saat data dashboard dimuat ulang, terapkan kembali filter yang sedang aktif.
        window.applyDashboardSPBUFilter = function () {
            if (activeFilter) {
                const current = activeFilter;
                activeFilter = '';
                applyFilter(current);
            }
        };

        setButtonState();
    })();

