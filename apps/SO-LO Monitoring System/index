    // =========================
    // EDITOR MODE + PIN
    // PIN is stored only as SHA-256 hash in localStorage.
    // For stronger multi-user/server-side enforcement, pair this UI with Supabase Auth/RPC.
    // =========================
    const EDITOR_DURATION_MS = 10 * 60 * 1000;
    let editorUnlockedUntil = 0;
    let editorTimerHandle = null;
    let pinAction = null;
    let pendingEdit = null;

    // INPUT SO LOCK: UI-only accidental-access protection.
    let soInputUnlocked = false;

    const pinModal = document.getElementById('pinModal');
    const pinModalTitle = document.getElementById('pinModalTitle');
    const pinModalMessage = document.getElementById('pinModalMessage');
    const pinModalHint = document.getElementById('pinModalHint');
    const pinInput = document.getElementById('pinInput');
    const pinSubmitBtn = document.getElementById('pinSubmitBtn');
    const pinCancelBtn = document.getElementById('pinCancelBtn');

    const editModal = document.getElementById('editModal');
    const editModalTitle = document.getElementById('editModalTitle');
    const editModalMessage = document.getElementById('editModalMessage');
    const editModalFields = document.getElementById('editModalFields');
    const editSaveBtn = document.getElementById('editSaveBtn');
    const editCancelBtn = document.getElementById('editCancelBtn');

    function getStoredPinHash() { return localStorage.getItem('solo_editor_pin_hash'); }

    function unlockSOInput() {
        soInputUnlocked = true;
        document.getElementById('soInputCard').classList.remove('so-input-locked');
        document.getElementById('soLockPanel').style.display = 'none';
        document.getElementById('so_number').focus();
    }

    function lockSOInput() {
        soInputUnlocked = false;
        document.getElementById('soInputCard').classList.add('so-input-locked');
        document.getElementById('soLockPanel').style.display = '';
    }

    async function sha256(text) {
        const data = new TextEncoder().encode(text);
        const hash = await crypto.subtle.digest('SHA-256', data);
        return [...new Uint8Array(hash)].map(b => b.toString(16).padStart(2, '0')).join('');
    }

    function validPin(pin) {
        return /^\d{4,12}$/.test(pin);
    }

    function openPinModal(action, title, message, hint = '') {
        pinAction = action;
        pinModalTitle.textContent = title;
        pinModalMessage.textContent = message;
        pinModalHint.textContent = hint;
        pinInput.value = '';
        pinInput.type = 'password';
        pinModal.classList.add('show');
        pinModal.setAttribute('aria-hidden', 'false');
        setTimeout(() => pinInput.focus(), 30);
    }

    function closePinModal() {
        pinAction = null;
        pinModal.classList.remove('show');
        pinModal.setAttribute('aria-hidden', 'true');
    }

    async function activateEditor() {
        editorUnlockedUntil = Date.now() + EDITOR_DURATION_MS;
        document.body.classList.add('editor-active');
        updateEditorStatus();
        if (editorTimerHandle) clearInterval(editorTimerHandle);
        editorTimerHandle = setInterval(updateEditorStatus, 1000);
        await fetchDashboard();
    }

    function lockEditor() {
        editorUnlockedUntil = 0;
        document.body.classList.remove('editor-active');
        if (editorTimerHandle) clearInterval(editorTimerHandle);
        editorTimerHandle = null;
        document.getElementById('editorStatus').textContent = '🔒 Mode Editor Terkunci';
        document.getElementById('editorStatus').classList.remove('active');
        document.body.classList.remove('editor-active');
        const editorBtn = document.getElementById('openEditorBtn');
        if (editorBtn) editorBtn.textContent = '🔒 Mode Editor';
        document.getElementById('editorTimer').textContent = '';
    }

    function updateEditorStatus() {
        const remaining = editorUnlockedUntil - Date.now();
        if (remaining <= 0) {
            lockEditor();
            return;
        }
        const totalSec = Math.ceil(remaining / 1000);
        const min = String(Math.floor(totalSec / 60)).padStart(2, '0');
        const sec = String(totalSec % 60).padStart(2, '0');
        const status = document.getElementById('editorStatus');
        status.textContent = '🟢 Mode Editor Aktif';
        status.classList.add('active');
        document.body.classList.add('editor-active');
        const editorBtn = document.getElementById('openEditorBtn');
        if (editorBtn) editorBtn.textContent = '🔓 Mode Editor Aktif';
        document.getElementById('editorTimer').textContent = `Terkunci otomatis dalam ${min}:${sec}`;
    }

    function ensureEditor() {
        if (editorUnlockedUntil > Date.now()) return true;
        lockEditor();
        alert('Mode Editor terkunci. Aktifkan kembali untuk melakukan perubahan.');
        return false;
    }

    document.getElementById('openSOInputBtn').addEventListener('click', () => {
        if (!getStoredPinHash()) {
            openPinModal('create-so-unlock', 'Buat PIN Editor', 'Belum ada PIN Editor. Buat PIN baru untuk membuka Input SO.', 'Gunakan 4–12 angka.');
        } else {
            openPinModal('unlock-so', 'Buka Input SO', 'Masukkan PIN Editor untuk membuka menu Input SO.', 'Input SO akan terkunci kembali saat aplikasi dimuat ulang atau dikunci manual.');
        }
    });

    document.getElementById('lockSOInputBtn').addEventListener('click', () => {
        lockSOInput();
    });

    document.getElementById('openEditorBtn').addEventListener('click', async () => {
        if (editorUnlockedUntil > Date.now()) {
            lockEditor();
            return;
        }
        if (!getStoredPinHash()) {
            openPinModal('create', 'Buat PIN Editor', 'Belum ada PIN Editor. Buat PIN baru untuk melindungi perubahan data.', 'Gunakan 4–12 angka.');
        } else {
            openPinModal('unlock', 'Buka Mode Editor', 'Masukkan PIN untuk membuka akses perubahan data selama 10 menit.');
        }
    });

    document.getElementById('changePinBtn').addEventListener('click', () => {
        if (!getStoredPinHash()) {
            openPinModal('create', 'Buat PIN Editor', 'Buat PIN baru untuk Mode Editor.', 'Gunakan 4–12 angka.');
        } else {
            openPinModal('change-verify', 'Ubah PIN Editor', 'Masukkan PIN lama terlebih dahulu.');
        }
    });

    document.getElementById('lockEditorBtn').addEventListener('click', lockEditor);
    pinCancelBtn.addEventListener('click', closePinModal);

    pinModal.addEventListener('click', (e) => {
        if (e.target === pinModal) closePinModal();
    });

    pinSubmitBtn.addEventListener('click', async () => {
        const pin = pinInput.value.trim();
        if (!validPin(pin)) {
            pinModalHint.textContent = 'PIN harus terdiri dari 4 sampai 12 angka.';
            return;
        }

        const hash = await sha256(pin);
        const existing = getStoredPinHash();

        if (pinAction === 'create-so-unlock') {
            localStorage.setItem('solo_editor_pin_hash', hash);
            closePinModal();
            alert('PIN Editor berhasil dibuat.');
            unlockSOInput();
            return;
        }

        if (pinAction === 'unlock-so') {
            if (hash !== existing) {
                pinModalHint.textContent = 'PIN salah.';
                return;
            }
            closePinModal();
            unlockSOInput();
            return;
        }

        if (pinAction === 'create') {
            localStorage.setItem('solo_editor_pin_hash', hash);
            closePinModal();
            alert('PIN Editor berhasil dibuat.');
            await activateEditor();
            return;
        }

        if (pinAction === 'unlock') {
            if (hash !== existing) {
                pinModalHint.textContent = 'PIN salah.';
                return;
            }
            closePinModal();
            await activateEditor();
            return;
        }

        if (pinAction === 'change-verify') {
            if (hash !== existing) {
                pinModalHint.textContent = 'PIN lama salah.';
                return;
            }
            pinAction = 'change-new';
            pinModalTitle.textContent = 'Buat PIN Baru';
            pinModalMessage.textContent = 'Masukkan PIN baru untuk Mode Editor.';
            pinModalHint.textContent = 'Gunakan 4–12 angka.';
            pinInput.value = '';
            return;
        }

        if (pinAction === 'change-new') {
            localStorage.setItem('solo_editor_pin_hash', hash);
            closePinModal();
            alert('PIN Editor berhasil diubah.');
        }
    });

