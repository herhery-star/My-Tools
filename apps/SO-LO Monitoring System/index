<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SO - LO Monitoring System</title>

    <!-- PWA Configurations & Icons -->
    <meta name="application-name" content="SO-LO Monitoring">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="SO-LO Monitoring">
    <meta name="theme-color" content="#121316">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="./manifest.json">
    <link rel="apple-touch-icon" href="./pwa_icon_192x192.png">

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root {
            --bg: #f8fafc;
            --card: #ffffff;
            --border: #e2e8f0;
            --text: #0f172a;
            --muted: #64748b;
            --primary: #2563eb;
            --danger: #ef4444;
            --warning: #f59e0b;
            --success: #10b981;
        }

        * { box-sizing: border-box; }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 20px;
        }

        .container { max-width: 1200px; margin: 0 auto; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }

        .card, .so-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

        h1 { margin-top: 0; }
        h2 { margin-top: 0; font-size: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
        h3 { margin-top: 28px; }

        .form-group { margin-bottom: 12px; }
        label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: 5px; }

        input, select, button {
            width: 100%;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font: inherit;
        }

        button {
            background: var(--primary);
            color: white;
            border: none;
            font-weight: 600;
            cursor: pointer;
        }

        button:hover { opacity: .92; }

        .product-choice {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .product-choice input[type="checkbox"] {
            width: auto;
            transform: scale(1.1);
        }

        .product-choice select {
            width: auto;
            min-width: 105px;
        }

        /* SPBU shading for LO product selector */
    #lo_so_product_select.spbu-select-blue {
      background-color: rgba(59,130,246,0.18);
      border-color: #3b82f6;
    }

    #lo_so_product_select.spbu-select-green {
      background-color: rgba(34,197,94,0.18);
      border-color: #22c55e;
    }

    /* SPBU dashboard shading */
    .so-card.spbu-green {
      background: linear-gradient(90deg, rgba(34,197,94,0.18), rgba(255,255,255,0.98) 42%);
      border-left: 6px solid #22c55e;
    }

    .so-card.spbu-blue {
      background: linear-gradient(90deg, rgba(59,130,246,0.18), rgba(255,255,255,0.98) 42%);
      border-left: 6px solid #3b82f6;
    }

    /* FILTER SPBU DASHBOARD */
    .dashboard-spbu-filter-wrap {
        margin: 0 0 20px;
       font-size: 2rem; }

    .dashboard-spbu-filter {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin: 0 0 8px;
    }

    .dashboard-spbu-filter button {
        width: auto;
        min-width: 205px;
        min-height: 48px;
        padding: 10px 18px;
        border-radius: 7px;
        font-size: .98rem;
        font-weight: 800;
        letter-spacing: .1px;
        border: 3px solid currentColor;
        transition: opacity .15s ease, transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }

    .dashboard-spbu-filter .filter-spbu-blue {
        background: #1e40af;
        color: #fff;
        border-color: #172554;
        box-shadow: 0 2px 0 #0f172a, 0 4px 9px rgba(30,64,175,.30);
    }

    .dashboard-spbu-filter .filter-spbu-green {
        background: #15803d;
        color: #fff;
        border-color: #14532d;
        box-shadow: 0 2px 0 #052e16, 0 4px 9px rgba(21,128,61,.30);
    }

    .dashboard-spbu-filter button.is-active {
        opacity: 1;
        transform: translateY(-1px);
    }

    .dashboard-spbu-filter .filter-spbu-blue.is-active {
        border-color: #020617;
        box-shadow: 0 0 0 2px #60a5fa, 0 3px 0 #0f172a, 0 5px 12px rgba(30,64,175,.38);
    }

    .dashboard-spbu-filter .filter-spbu-green.is-active {
        border-color: #052e16;
        box-shadow: 0 0 0 2px #4ade80, 0 3px 0 #052e16, 0 5px 12px rgba(21,128,61,.38);
    }

    .dashboard-spbu-filter button:not(.is-active) {
        opacity: .82;
    }

    .dashboard-spbu-filter button:hover { opacity: 1; }

    .dashboard-spbu-filter button:focus-visible {
        outline: 3px solid #0f172a;
        outline-offset: 2px;
    }

    .dashboard-filter-help {
        font-size: .84rem;
        color: #475569;
        line-height: 1.5;
        padding: 7px 2px 0;
    }

    .dashboard-filter-help strong {
        color: #0f172a;
    }

    .dashboard-filter-empty {
        padding: 18px;
        color: #64748b;
        border: 1px dashed #cbd5e1;
        border-radius: 10px;
        background: #fff;
    }

    .so-card.dashboard-spbu-hidden {
        display: none !important;
    }

    @media (max-width: 640px) {
        .dashboard-spbu-filter {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
        .dashboard-spbu-filter button {
            width: 100%;
            min-width: 0;
            padding: 10px 8px;
            font-size: .88rem;
        }
    }

    .so-card { margin-bottom: 16px; padding: 16px; }

        .so-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 12px;
            border-bottom: 2px solid var(--border);
            padding-bottom: 10px;
        }

        .so-header-left { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

        .spbu-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 9px;
            border-radius: 999px;
            background: #dbeafe;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            font-size: .78rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .product-row {
            margin-left: 12px;
            padding: 10px 0;
            border-bottom: 1px dashed var(--border);
        }

        .status-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 700;
            font-size: .85rem;
        }

        .status-belum { color: var(--danger); background: #fef2f2; }
        .status-tersisa { color: #b45309; background: #fffbeb; }
        .status-selesai { color: #047857; background: #ecfdf5; }

        .lo-item {
            margin-left: 24px;
            font-size: .9rem;
            color: #475569;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            max-width: 650px;
            margin-top: 6px;
        }

        .divider {
            border-top: 3px double #94a3b8;
            margin: 32px 0;
            text-align: center;
            line-height: 0;
        }

        .divider span {
            background: var(--bg);
            padding: 0 12px;
            color: var(--muted);
            font-weight: 700;
        }

        .btn-del {
            width: auto;
            padding: 5px 9px;
            background: var(--danger);
            font-size: .78rem;
            white-space: nowrap;
        }

        .btn-del-so {
            margin-top: 12px;
            width: auto;
            padding: 7px 10px;
            background: var(--danger);
        }

        .empty-state {
            padding: 20px;
            color: var(--muted);
            border: 1px dashed var(--border);
            border-radius: 8px;
            background: #fff;
        }


        /* EDITOR MODE */
        .editor-bar {
            display:flex; align-items:center; justify-content:space-between; gap:12px;
            background:#fff; border:1px solid var(--border); border-radius:10px;
            padding:12px 16px; margin-bottom:20px;
        }
        .editor-status { font-weight:700; color:#475569; }
        .editor-status.active { color:#047857; }
        .editor-actions { display:flex; gap:8px; flex-wrap:wrap; }
        .editor-actions button { width:auto; }
        .btn-editor { background:#475569; }
        .btn-lock { background:#334155; }
        .btn-edit { width:auto; padding:5px 9px; background:#f59e0b; font-size:.78rem; white-space:nowrap; }
        .editor-only { display:none; }
        body.editor-active .editor-only { display:inline-block; }
        .modal input, .modal select { margin-top:10px; }
        .modal small { display:block; margin-top:8px; color:#64748b; line-height:1.45; }

        /* CUSTOM CONFIRMATION MODAL */
        .modal-overlay {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, .55);
            z-index: 9999;
        }

        .modal-overlay.show { display: flex; }

        .modal {
            width: min(430px, 100%);
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 20px 50px rgba(0,0,0,.25);
            padding: 24px;
            animation: modalIn .18s ease-out;
        }

        @keyframes modalIn {
            from { opacity: 0; transform: translateY(8px) scale(.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #fef2f2;
            color: var(--danger);
            font-size: 1.5rem;
            margin-bottom: 12px;
        }

        .modal h3 { margin: 0 0 8px; font-size: 1.15rem; }
        .modal p { margin: 0; color: #475569; line-height: 1.55; }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 22px;
        }

        .modal-actions button { width: auto; min-width: 100px; }
        .btn-cancel { background: #e2e8f0; color: #334155; }
        .btn-confirm-delete { background: var(--danger); }

        /* NOMOR SO & LO — font 2x lebih besar agar mudah dibaca saat input */
        #so_number,
        #lo_number {
            font-size: 2rem;
            line-height: 1.2;
            min-height: 60px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            letter-spacing: .02em;
        }

        /* POPUP VERIFIKASI PILIH SO PRODUK */
        .so-verify-modal {
            width: min(520px, 100%);
            padding: 26px;
        }

        .so-verify-modal .modal-icon {
            width: 54px;
            height: 54px;
            font-size: 1.75rem;
            background: #eff6ff;
            color: #2563eb;
        }

        .so-verify-modal h3 {
            font-size: 1.45rem;
            margin-bottom: 10px;
        }

        .so-verify-question {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 16px;
        }

        .so-verify-details {
            display: grid;
            gap: 9px;
            padding: 16px;
            border: 1px solid #dbe3ee;
            border-radius: 12px;
            background: #f8fafc;
        }

        .so-verify-row {
            display: grid;
            grid-template-columns: 105px minmax(0, 1fr);
            gap: 10px;
            align-items: baseline;
            font-size: 1.12rem;
        }

        .so-verify-row span:first-child {
            color: #64748b;
            font-weight: 600;
        }

        .so-verify-row span:last-child {
            color: #0f172a;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        /* Nilai utama pada popup verifikasi dibuat lebih menonjol */
        .so-verify-row.so-verify-number span:last-child,
        .so-verify-row.so-verify-product span:last-child {
            font-size: 1.68rem;
            line-height: 1.15;
            font-weight: 900;
            letter-spacing: .01em;
        }

        .so-verify-row.so-verify-number span:last-child {
            font-variant-numeric: tabular-nums;
        }

        .so-verify-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 22px;
        }

        .so-verify-actions button {
            width: 100%;
            min-height: 56px;
            font-size: 1.12rem;
            border-radius: 10px;
        }

        .so-verify-ok {
            background: #16a34a;
        }

        .so-verify-cancel {
            background: #e2e8f0;
            color: #334155;
        }

        @media (max-width: 640px) {
            #so_number,
            #lo_number {
                font-size: 2rem;
                min-height: 62px;
            }

            .so-verify-modal {
                padding: 22px 18px;
            }

            .so-verify-row {
                grid-template-columns: 88px minmax(0, 1fr);
                font-size: 1.05rem;
            }

            .so-verify-row.so-verify-number span:last-child,
            .so-verify-row.so-verify-product span:last-child {
                font-size: 1.55rem;
            }
        }

        @media (max-width: 800px) {
            body { padding: 12px; }
            .grid { grid-template-columns: 1fr; }
            .so-header { align-items: flex-start; flex-direction: column; }
            .lo-item { margin-left: 0; }
        }

    /* =========================
       INPUT SO LOCK (UI ONLY)
       ========================= */
    .so-lock-panel {
        margin-bottom: 16px;
        padding: 16px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
        text-align: center;
    }
    .so-lock-panel strong {
        display: block;
        margin-bottom: 6px;
    }
    .so-lock-panel p {
        margin: 0 0 12px;
        color: #64748b;
        font-size: 13px;
    }
    .so-input-locked {
        display: none !important;
    }
    .btn-so-unlock, .btn-so-lock {
        width: auto;
        min-width: 180px;
    }


        /* =========================
           LO SO-PRODUCT DROPDOWN
           TAMBAHAN TAMPILAN SAJA
        ========================= */
        #lo_so_product_select {
            font-size: 0.82rem;
        }

        #lo_so_product_select option {
            font-size: 0.82rem;
        }

        #lo_so_product_select option.spbu-option-blue {
            border-left: 6px solid #2563eb;
        }

        #lo_so_product_select option.spbu-option-green {
            border-left: 6px solid #16a34a;
        }


        /* =========================================
           PILIH SO PRODUK - TAB/KARTU PILIHAN
           Tambahan UI saja; select lama tetap dipakai
        ========================================= */
        #lo_so_product_select {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        .so-product-tabs {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 10px;
            margin-top: 8px;
        }

        .so-product-tab {
            width: 100%;
            padding: 0;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #fff;
            color: inherit;
            text-align: left;
            overflow: hidden;
            cursor: pointer;
            font: inherit;
        }

        .so-product-tab.spbu-blue { border-left: 6px solid #2563eb; }
        .so-product-tab.spbu-green { border-left: 6px solid #16a34a; }

        .so-product-tab-top,
        .so-product-tab-bottom {
            display: grid;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
        }

        .so-product-tab-top {
            grid-template-columns: minmax(0,1fr) auto;
            border-bottom: 1px solid #e2e8f0;
            font-size: .78rem;
            background: #f8fafc;
        }

        .so-product-tab.spbu-blue .so-product-tab-top { background: #eff6ff; }
        .so-product-tab.spbu-green .so-product-tab-top { background: #f0fdf4; }

        .so-product-tab-bottom {
            grid-template-columns: auto minmax(0,1fr) auto;
            font-size: .88rem;
            font-weight: 600;
        }

        .so-product-tab.is-selected {
            border-color: #0f172a;
            box-shadow: 0 0 0 2px rgba(15,23,42,.12);
        }

        .so-product-tab.is-selected .so-product-so::before { content: '✓ '; }

        .so-product-date,
        .so-product-so,
        .so-product-product,
        .so-product-spbu,
        .so-product-sisa {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .so-product-date,
        .so-product-spbu,
        .so-product-sisa { color: #475569; }

        .so-product-sisa { font-size: .80rem; }

        .so-product-tabs-empty {
            padding: 12px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            color: #64748b;
            font-size: .86rem;
        }

        @media (max-width:640px) {
            .so-product-tabs { grid-template-columns: 1fr; }
            .so-product-tab-bottom { grid-template-columns: auto minmax(0,1fr); }
            .so-product-sisa { grid-column: 1 / -1; }
        }


        /* =========================================
           HALAMAN 2 - PILIH SO PRODUK
        ========================================= */
        .so-picker-view { display:none; }
        .so-picker-view.is-open { display:block; }
        .so-picker-main.is-hidden { display:none !important; }

        .lo-so-picker-trigger {
            width:100%;
            min-height:48px;
            padding:11px 14px;
            border:1px solid #cbd5e1;
            border-radius:10px;
            background:#fff;
            color:#334155;
            text-align:left;
            cursor:pointer;
            font:inherit;
        }



        /* =========================================
           PENEGASAN AREA INPUT LO
        ========================================= */
        .lo-input-card {
            border: 2px solid rgba(37, 99, 235, .48);
            border-radius: 14px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
            box-shadow:
                0 4px 14px rgba(37, 99, 235, .10),
                0 1px 3px rgba(15, 23, 42, .08);
        }

        .lo-input-card h2 {
            border-bottom: 2px solid rgba(37, 99, 235, .24);
            color: #1e3a5f;
        }

        .lo-input-card label {
            color: #1e3a5f;
        }

        /* Shading biru → aqua → hijau lembut pada semua kotak input LO */
        .lo-input-card input,
        .lo-input-card select,
        .lo-input-card .lo-so-picker-trigger {
            border: 1.5px solid rgba(70, 125, 150, .38);
            background:
                linear-gradient(
                    135deg,
                    #e3f1ff 0%,
                    #e8f7f4 52%,
                    #def4e8 100%
                );
            border-radius: 10px;
            color: #1f2d3d;
        }

        .lo-input-card input:hover,
        .lo-input-card select:hover,
        .lo-input-card .lo-so-picker-trigger:hover {
            border-color: #5b9c9b;
            background:
                linear-gradient(
                    135deg,
                    #dcedff 0%,
                    #e1f5f0 52%,
                    #d5efdf 100%
                );
            opacity: 1;
        }

        .lo-input-card input:focus,
        .lo-input-card select:focus {
            outline: none;
            border-color: #3d72c9;
            background:
                linear-gradient(
                    135deg,
                    #dceeff 0%,
                    #e2f7f2 52%,
                    #d9f1e3 100%
                );
            box-shadow:
                0 0 0 3px rgba(61, 114, 201, .12),
                0 4px 12px rgba(47, 139, 104, .08);
        }

        .lo-input-card .lo-so-picker-trigger {
            color: #294b78;
        }

        .lo-input-card button[type="submit"] {
            min-height: 52px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(37, 99, 235, .22);
        }

        .so-picker-header {
            display:flex;
            align-items:center;
            gap:12px;
            margin-bottom:16px;
        }

        .so-picker-back {
            /* Override tombol global width:100% agar tidak muncul kotak kosong panjang */
            width:auto !important;
            min-width:42px;
            width:42px !important;
            height:42px;
            min-height:42px;
            flex:0 0 42px;
            padding:0 !important;
            border:1px solid #cbd5e1;
            border-radius:10px;
            background:#fff;
            color:#334155 !important;
            cursor:pointer;
            font-size:20px;
            line-height:1;
        }

        .so-picker-title { margin:0; font-size:1.05rem; }

        .so-picker-list {
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
            gap:10px;
        }

        .so-picker-item {
            width:100%;
            padding:0;
            border:1px solid #e2e8f0;
            border-radius:12px;
            background:#fff;
            color:inherit;
            text-align:left;
            overflow:hidden;
            cursor:pointer;
            font:inherit;
        }

        .so-picker-item.spbu-blue { border-left:6px solid #2563eb; }
        .so-picker-item.spbu-green { border-left:6px solid #16a34a; }

        .so-picker-item-top,
        .so-picker-item-bottom {
            display:grid;
            align-items:center;
            gap:10px;
            padding:10px 12px;
        }

        .so-picker-item-top {
            grid-template-columns:minmax(0,1fr) auto;
            border-bottom:1px solid #e2e8f0;
            font-size:.80rem;
            background:#f8fafc;
        }

        .so-picker-item.spbu-blue .so-picker-item-top { background:#eff6ff; }
        .so-picker-item.spbu-green .so-picker-item-top { background:#f0fdf4; }

        .so-picker-item-bottom {
            grid-template-columns:auto minmax(0,1fr) auto;
            font-size:.90rem;
            font-weight:600;
        }

        .so-picker-date,.so-picker-spbu,.so-picker-so,.so-picker-product,.so-picker-sisa {
            white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }
