    async function fetchDashboard() {
        const activeContainer = document.getElementById('dashboardActive');
        const completedContainer = document.getElementById('dashboardCompleted');
        const loSelect = document.getElementById('lo_so_product_select');

        activeContainer.innerHTML = 'Loading data...';
        completedContainer.innerHTML = 'Loading data...';
        loSelect.innerHTML = '<option value="">-- Pilih SO Produk --</option>';

        try {
            if (!window.supabase || !sb || typeof sb.from !== 'function') {
                throw new Error('Supabase client tidak berhasil diinisialisasi. Periksa koneksi internet atau library Supabase.');
            }

            const { data: soList, error } = await sb
                .from('so')
                .select(`
                    id,
                    nomor_so,
                    tanggal_so,
                    spbu,
                    completed_at,
                    deleted_at,
                    so_products (
                        id,
                        product_name,
                        quantity_so,
                        lo (
                            id,
                            nomor_lo,
                            tanggal_lo,
                            quantity_lo,
                            deleted_at
                        )
                    )
                `)
                .is('deleted_at', null);

            if (error) throw error;

            const safeList = soList || [];

            // Tambahan Resume: snapshot data yang sama, tanpa query baru.
            resumeSOData = safeList;
            renderResumeBBM();

            activeContainer.innerHTML = '';
            completedContainer.innerHTML = '';
            loSelect.innerHTML = '<option value="">-- Pilih SO Produk --</option>';

            const activeSOs = safeList
                .filter(so => !so.completed_at)
                .sort((a, b) => new Date(a.tanggal_so) - new Date(b.tanggal_so));

            const completedSOs = safeList
                .filter(so => so.completed_at)
                .sort((a, b) => new Date(b.completed_at) - new Date(a.completed_at));

            function renderSO(so, targetEl, isActive) {
                const spbuClass = so.spbu === 'SPBU-74.906.16' ? 'spbu-green-row' : so.spbu === 'SPBU-74.906.07' ? 'spbu-blue-row' : '';
                const products = so.so_products || [];
                let rows = '';
                products.forEach(prod => {
                    const activeLOs = (prod.lo || []).filter(lo => !lo.deleted_at);
                    const totalLO = activeLOs.reduce((sum, lo) => sum + Number(lo.quantity_lo || 0), 0);
                    const soQty = Number(prod.quantity_so || 0);
                    const sisa = Math.max(0, soQty - totalLO);
                    const statusHtml = totalLO >= soQty
                        ? '<span class="status-badge status-tersent">Terkirim</span>'
                        : '<span class="status-badge status-belum">Belum</span>';
                    const loHtml = activeLOs.length
                        ? activeLOs.map(lo => `
                            <div class="lo-item-inline">
                                <button type="button" class="lo-link" data-lo-id="${escapeHtml(lo.id)}" title="Lihat detail LO">${escapeHtml(lo.nomor_lo)}</button>
                                <span class="lo-editor-actions editor-only">
                                    <button type="button" class="lo-action-edit" data-edit-lo="${escapeHtml(lo.id)}" data-lo-number="${escapeHtml(lo.nomor_lo)}" data-lo-qty="${Number(lo.quantity_lo || 0)}" data-lo-date="${escapeHtml(lo.tanggal_lo || '')}" title="Edit LO">✎</button>
                                    <button type="button" class="lo-action-delete" data-delete-lo="${escapeHtml(lo.id)}" data-lo-number="${escapeHtml(lo.nomor_lo)}" title="Hapus LO">×</button>
                                </span>
                            </div>
                        `).join('')
                        : '<span class="lo-empty">-</span>';

                    if (isActive && sisa > 0) {
                        const option = document.createElement('option');
                        option.value = prod.id;
                        option.dataset.product = prod.product_name || '';
                        option.dataset.remaining = String(sisa);
                        option.dataset.spbu = so.spbu || '';
                        option.dataset.tanggal = formatDate(so.tanggal_so);
                        option.dataset.nomorSo = so.nomor_so || '';
                        option.textContent = `${so.nomor_so} | ${formatDate(so.tanggal_so)}${so.spbu ? ' | ' + so.spbu : ''} | ${prod.product_name} | Sisa: ${sisa} KL`;
                        loSelect.appendChild(option);
                    }

                    rows += `<tr class="${spbuClass}">
                        <td>${escapeHtml(so.nomor_so)}</td>
                        <td>${formatDate(so.tanggal_so)}</td>
                        <td>${escapeHtml(prod.product_name || '')}</td>
                        <td>${soQty}</td>
                        <td>${totalLO}</td>
                        <td><b>${sisa}</b></td>
                        <td>${loHtml}</td>
                        <td>${statusHtml}</td>
                        
                    </tr>`;
                });

                const sectionClass = so.spbu === 'SPBU-74.906.16' ? 'spbu-green-section' : so.spbu === 'SPBU-74.906.07' ? 'spbu-blue-section' : '';
                const html = `<div class="so-table-card ${sectionClass}" data-dashboard-spbu="${escapeHtml(so.spbu || '')}">
                    <div class="so-table-head">
                        <div class="so-head-main">
                            <strong>SO: ${escapeHtml(so.nomor_so)}</strong>
                            <span class="spbu-badge">${escapeHtml(so.spbu || '')}</span>
                            <span class="so-date">${formatDate(so.tanggal_so)}</span>
                        </div>
                        <div class="so-editor-actions editor-only">
                            <button type="button" class="btn-edit-so" data-edit-so="${escapeHtml(so.id)}" title="Edit SO">✎</button>
                            <button type="button" class="btn-delete-so" data-delete-so="${escapeHtml(so.id)}" data-delete-so-number="${escapeHtml(so.nomor_so)}" title="Hapus SO">×</button>
                        </div>
                    </div>
                    <div class="table-scroll"><table class="dashboard-table"><thead><tr><th>No. SO</th><th>Tanggal</th><th>Produk</th><th>SO (KL)</th><th>Terkirim (KL)</th><th>Sisa (KL)</th><th>LO Terkait</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div>
                </div>`;
                targetEl.insertAdjacentHTML('beforeend', html);
            }

            if (activeSOs.length === 0) {
                activeContainer.innerHTML = '<div class="empty-state">Belum ada SO aktif.</div>';
            } else {
                activeSOs.forEach(so => renderSO(so, activeContainer, true));
            }

            if (completedSOs.length === 0) {
                completedContainer.innerHTML = '<div class="empty-state">Belum ada SO selesai.</div>';
            } else {
                completedSOs.forEach(so => renderSO(so, completedContainer, false));
            }

            const activeCount = activeSOs.length;
            const completedCount = completedSOs.length;
            let deliveredTotal = 0, remainingTotal = 0;
            safeList.forEach(so => (so.so_products || []).forEach(prod => {
                const sent = (prod.lo || []).filter(lo => !lo.deleted_at).reduce((s, lo) => s + Number(lo.quantity_lo || 0), 0);
                deliveredTotal += sent;
                remainingTotal += Math.max(0, Number(prod.quantity_so || 0) - sent);
            }));
            const setMetric = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
            setMetric('metricActive', activeCount);
            setMetric('metricCompleted', completedCount);
            setMetric('metricDelivered', `${deliveredTotal} KL`);
            setMetric('metricRemaining', `${remainingTotal} KL`);
            setMetric('dashboardUpdateTime', new Date().toLocaleString('id-ID', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}));
            renderSOPicker();
            if (typeof window.applyDashboardSPBUFilter === 'function') {
                window.applyDashboardSPBUFilter();
            }

        } catch (error) {
            console.error('fetchDashboard error:', error);
            const message = error?.message || String(error);
            activeContainer.innerHTML = `<div class="empty-state" style="color:#b91c1c;border-color:#fecaca;background:#fff1f2;"><strong>Gagal memuat dashboard SO Aktif.</strong><br>${escapeHtml(message)}</div>`;
            completedContainer.innerHTML = `<div class="empty-state" style="color:#b91c1c;border-color:#fecaca;background:#fff1f2;"><strong>Gagal memuat dashboard SO Selesai.</strong></div>`;
            loSelect.innerHTML = '<option value="">-- Pilih SO Produk --</option>';
            renderSOPicker();
        }
    }

    // =========================
    // FILTER DASHBOARD BERDASARKAN SPBU
