    // =========================
    document.addEventListener('click', (event) => {
        const editSO = event.target.closest('[data-edit-so]');
        if (editSO) {
            if (!ensureEditor()) return;
            const card = editSO.closest('.so-table-card');
            const title = card?.querySelector('.so-table-head strong')?.textContent || '';
            const nomorSO = title.replace(/^SO:\s*/, '').trim();
            const spbu = card?.querySelector('.spbu-badge')?.textContent?.trim() || '';
            const dateText = card?.querySelector('.so-date')?.textContent?.trim() || '';
            const isoDate = (() => {
                const m = dateText.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
                return m ? `${m[3]}-${String(m[2]).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}` : '';
            })();
            openEditSO(editSO.dataset.editSo, nomorSO, isoDate, spbu);
            return;
        }

        const deleteSO = event.target.closest('[data-delete-so]');
        if (deleteSO) {
            if (!ensureEditor()) return;
            confirmDeleteSO(deleteSO.dataset.deleteSo, deleteSO.dataset.deleteSoNumber || '');
            return;
        }

        const editLO = event.target.closest('[data-edit-lo]');
        if (editLO) {
            if (!ensureEditor()) return;
            openEditLO(
                editLO.dataset.editLo,
                editLO.dataset.loNumber || '',
                Number(editLO.dataset.loQty || 0),
                editLO.dataset.loDate || ''
            );
            return;
        }

        const deleteLO = event.target.closest('[data-delete-lo]');
        if (deleteLO) {
            if (!ensureEditor()) return;
            confirmDeleteLO(deleteLO.dataset.deleteLo, deleteLO.dataset.loNumber || '');
            return;
        }
    });

    // Enter key submits the PIN modal, which makes the editor usable without
    // having to click "Lanjutkan".
    pinInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            pinSubmitBtn.click();
        }
    });


    // Editor UI visibility is controlled by body.editor-active.
    // Start locked by default.
    document.body.classList.remove('editor-active');

    // =========================
    // INITIAL FETCH & REALTIME
    // =========================

    // Event untuk kontrol picker dipasang setelah DOM siap.
    // Ini memastikan tombol tetap aktif meskipun urutan HTML berubah.
    function initSOPickerControls() {
        document.getElementById('openSOPickerBtn')
            ?.addEventListener('click', openSOPicker);

        document.getElementById('closeSOPickerBtn')
            ?.addEventListener('click', closeSOPicker);

        document.getElementById('soVerifyCancelBtn')
            ?.addEventListener('click', closeSOVerification);

        document.getElementById('soVerifyOkBtn')
            ?.addEventListener('click', confirmSOVerification);

        document.getElementById('soVerifyModal')
            ?.addEventListener('click', (event) => {
                if (event.target.id === 'soVerifyModal') closeSOVerification();
            });
    }

    if (document.readyState === 'loading') {
        window.addEventListener('DOMContentLoaded', initSOPickerControls, { once: true });
    } else {
        initSOPickerControls();
    }

    // Event untuk elemen lain yang berada setelah script utama.
    window.addEventListener('DOMContentLoaded', () => {
        document.getElementById('resumeDashboardTab')
            ?.addEventListener('click', closeResumeBBM);

        document.getElementById('resumeBBMTab')
            ?.addEventListener('click', openResumeBBM);
    });

    document.addEventListener('keydown', (event) => {
        const modal = document.getElementById('soVerifyModal');
        if (event.key === 'Escape' && modal?.classList.contains('show')) {
            closeSOVerification();
        }
    });

    // Always start with Input SO locked on page load.
    lockSOInput();

    // Load dashboard.
    fetchDashboard();

    // Realtime update.
    if (sb && typeof sb.channel === 'function') {
        sb.channel('schema-db-changes')
            .on(
                'postgres_changes',
                { event: '*', schema: 'public' },
                () => fetchDashboard()
            )
            .subscribe();
    }
</script>

