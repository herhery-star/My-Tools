    async function openLODetail(loId) {
        if (!loDetailModal || !loDetailContent || !loId) return;
        loDetailModal.classList.add('show');
        loDetailModal.setAttribute('aria-hidden', 'false');
        loDetailContent.innerHTML = loDetailRow('Status', 'Memuat data...');

        try {
            if (!sb) throw new Error('Koneksi Supabase belum siap.');

            const { data: lo, error } = await sb.from('lo').select(`
                id, nomor_lo, tanggal_lo, quantity_lo, deleted_at, so_product_id,
                so_products (
                    id, product_name, quantity_so,
                    so (id, nomor_so, tanggal_so, spbu, completed_at, deleted_at)
                )
            `).eq('id', loId).single();

            if (error) throw error;
            if (!lo) throw new Error('Data LO tidak ditemukan.');

            const product = Array.isArray(lo.so_products) ? lo.so_products[0] : lo.so_products;
            const so = product ? (Array.isArray(product.so) ? product.so[0] : product.so) : null;
            const statusHtml = lo.deleted_at
                ? '<span style="display:inline-block;padding:3px 7px;border-radius:999px;background:#ffe3e3;color:#ed3030;font-size:9px;font-weight:800">Tidak aktif</span>'
                : '<span class="lo-detail-status">Aktif</span>';

            loDetailContent.innerHTML =
                loDetailRow('Nomor LO', escapeHtml(lo.nomor_lo || '-')) +
                loDetailRow('Tanggal LO', escapeHtml(formatDate(lo.tanggal_lo))) +
                loDetailRow('SPBU', escapeHtml(so?.spbu || '-')) +
                loDetailRow('Nomor SO', escapeHtml(so?.nomor_so || '-')) +
                loDetailRow('Tanggal SO', escapeHtml(formatDate(so?.tanggal_so))) +
                loDetailRow('Produk', escapeHtml(product?.product_name || '-')) +
                loDetailRow('Quantity', `${escapeHtml(String(lo.quantity_lo ?? 0))} KL`, 'lo-detail-qty') +
                loDetailRow('Status', statusHtml);
        } catch (error) {
            console.error('openLODetail error:', error);
            loDetailContent.innerHTML = loDetailRow('Gagal', escapeHtml(error?.message || String(error)));
        }

        loDetailCloseBtn?.focus();
    }

