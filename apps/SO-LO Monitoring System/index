/* =========================================
   ADD-ON: FLOATING NAVIGATION
   + COLLAPSE BAGIAN 2 — SO SELESAI
   Kode lama tidak diubah
========================================= */

/* Navigasi berada tepat di tengah sisi kanan layar */
.floating-nav-addon {
    position: fixed;
    right: 8px;
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
    z-index: 9998;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

/* Tombol bulat dengan ikon segitiga */
.floating-nav-addon button {
    width: 34px;
    height: 34px;
    min-width: 34px;
    padding: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #2f64bd;
    color: transparent;
    border: 0;
    box-shadow: 0 3px 10px rgba(15, 23, 42, .20);
    line-height: 1;
    position: relative;
}

.floating-nav-addon button::before {
    content: "";
    display: block;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
}

/* Segitiga menghadap ke atas */
#floatingTopAddon::before {
    border-bottom: 10px solid #ffffff;
}

/* Segitiga menghadap ke bawah */
#floatingBottomAddon::before {
    border-top: 10px solid #ffffff;
}

.floating-nav-addon button:hover {
    background: #2563eb;
    opacity: 1;
    transform: scale(1.06);
}

.completed-title-row-addon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.completed-title-row-addon h3 {
    margin-top: 28px;
    margin-bottom: 0;
}

.completed-toggle-addon {
    width: 40px !important;
    min-width: 40px !important;
    height: 40px;
    padding: 0 !important;
    border-radius: 10px !important;
    display: grid !important;
    place-items: center !important;
    background: #475569 !important;
    font-size: 22px !important;
    line-height: 1;
}

#dashboardCompleted.completed-collapsed-addon {
    display: none;
}

@media (max-width: 640px) {
    .floating-nav-addon {
        right: 6px;
    }

    .floating-nav-addon button {
        width: 32px;
        height: 32px;
        min-width: 32px;
    }
}

